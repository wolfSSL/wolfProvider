<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <!-- A FIPS build points these at the bundle so wolfSSL and wolfProvider compile
         against one user_settings.h, e.g. msbuild ... /p:wolfSslLib=wolfssl-fips.lib
         /p:wolfCryptDir=C:\src\wolfssl-fips /p:userSettingsDir=C:\src\wolfssl-fips\IDE\WIN10 -->
    <userSettingsDir>..</userSettingsDir>
    <wolfSslLib>wolfssl.lib</wolfSslLib>
    <wolfCryptDir>..\..\..\..\wolfssl</wolfCryptDir>
    <openSslDir>..\..\..\..\openssl</openSslDir>
    <!-- A separate tree because the Debug configurations link /MDd and OpenSSL's
         Configure writes into its own source tree. A /MD libcrypto in a /MDd
         module links cleanly and then corrupts the heap. -->
    <openSslDirDebug>..\..\..\..\openssl-debug</openSslDirDebug>
    <wolfCryptDebug32>$(wolfCryptDir)\Debug\Win32</wolfCryptDebug32>
    <wolfCryptRelease32>$(wolfCryptDir)\Release\Win32</wolfCryptRelease32>
    <wolfCryptDebug64>$(wolfCryptDir)\Debug\x64</wolfCryptDebug64>
    <wolfCryptRelease64>$(wolfCryptDir)\Release\x64</wolfCryptRelease64>
    <wolfCryptDllDebug32>$(wolfCryptDir)\DLL Debug\Win32</wolfCryptDllDebug32>
    <wolfCryptDllRelease32>$(wolfCryptDir)\DLL Release\Win32</wolfCryptDllRelease32>
    <wolfCryptDllDebug64>$(wolfCryptDir)\DLL Debug\x64</wolfCryptDllDebug64>
    <wolfCryptDllRelease64>$(wolfCryptDir)\DLL Release\x64</wolfCryptDllRelease64>
  </PropertyGroup>
  <ItemDefinitionGroup />
  <ItemGroup>
    <BuildMacro Include="userSettingsDir">
      <Value>$(userSettingsDir)</Value>
    </BuildMacro>
    <BuildMacro Include="wolfSslLib">
      <Value>$(wolfSslLib)</Value>
    </BuildMacro>
    <BuildMacro Include="wolfCryptDir">
      <Value>$(wolfCryptDir)</Value>
    </BuildMacro>
    <BuildMacro Include="openSslDir">
      <Value>$(openSslDir)</Value>
    </BuildMacro>
    <BuildMacro Include="openSslDirDebug">
      <Value>$(openSslDirDebug)</Value>
    </BuildMacro>
    <BuildMacro Include="wolfCryptDebug32">
      <Value>$(wolfCryptDebug32)</Value>
    </BuildMacro>
    <BuildMacro Include="wolfCryptRelease32">
      <Value>$(wolfCryptRelease32)</Value>
    </BuildMacro>
    <BuildMacro Include="wolfCryptDebug64">
      <Value>$(wolfCryptDebug64)</Value>
    </BuildMacro>
    <BuildMacro Include="wolfCryptRelease64">
      <Value>$(wolfCryptRelease64)</Value>
    </BuildMacro>
    <BuildMacro Include="wolfCryptDllDebug32">
      <Value>$(wolfCryptDllDebug32)</Value>
    </BuildMacro>
    <BuildMacro Include="wolfCryptDllRelease32">
      <Value>$(wolfCryptDllRelease32)</Value>
    </BuildMacro>
    <BuildMacro Include="wolfCryptDllDebug64">
      <Value>$(wolfCryptDllDebug64)</Value>
    </BuildMacro>
    <BuildMacro Include="wolfCryptDllRelease64">
      <Value>$(wolfCryptDllRelease64)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>
